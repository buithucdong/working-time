{
  "manifest_version": 3,
  "name": "Working Time",
  "version": "1.4.0",
  "description": "Helps users stay focused by blocking distracting websites during work hours with advanced features.",
  "action": {
    "default_popup": "index.html",
    "default_title": "Working Time"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": ["storage", "tabs", "alarms", "declarativeNetRequestWithHostAccess"],
  "host_permissions": ["<all_urls>"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; style-src 'self'; font-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": ["blocked.html", "privacy.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "author": "Bui Thuc Dong",
  "homepage_url": "https://d-solutions.vn"
}
